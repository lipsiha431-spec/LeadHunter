# ==========================================
# Обязательные параметры авторизации Telegram
# ==========================================
# Данные Telegram Client API (получить на https://my.telegram.org)
API_ID=30968277
API_HASH=your_api_hash_here

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администратора (узнать в боте @userinfobot)
ADMIN_ID=1795524760

# ==========================================
# Настройки Telegram Mini App (Веб-сервер)
# ==========================================
MINI_APP_PORT=8080
MINI_APP_HOST=0.0.0.0

# Публичный URL приложения (если есть свой домен / reverse proxy).
# Оставьте пустым для авто-туннеля при локальном запуске:
MINI_APP_URL=

# Google Cloud Places API (New) ключ (опционально для глубокого поиска)
GOOGLE_PLACES_API_KEY=

# ==========================================
# Опциональные настройки прокси (SOCKS5 / HTTP)
# ==========================================
USE_PROXY=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808
PROXY_USER=
PROXY_PASS=

# ==========================================
# Реквизиты оплаты (СБП, Карты, Криптовалюта)
# ==========================================
PAY_SBP_PHONE=+7 (999) 000-00-00
PAY_SBP_BANK=Т-Банк / Сбер
PAY_CARD_NUMBER=2200 7000 0000 0000
PAY_CRYPTO_USDT_TRC20=TXxxYourUsdtTrc20AddressHerexxxxxxxx
PAY_CRYPTO_TON=UQYourTonWalletAddressHerexxxxxxxxxxxxxxxxx
ADMIN_USERNAME=your_admin_username
